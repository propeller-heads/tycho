# Rust build artifacts — by far the largest contributor to build context size
target/
**/target/

# Git history and local tooling
.git/
.claude/
.idea/

# Substreams workspace builds (separate toolchain, not needed for main images)
protocols/substreams/
# ...except the packages' integration test yamls, which tycho-integration-test embeds
!protocols/substreams/**/integration_test*.tycho.yaml

# Local dev files
.env
docker-compose*.yml
*.swp

# mise's personal overrides (mise.local.toml, mise.<env>.local.toml, ...), which may hold secrets
**/*.local.toml
