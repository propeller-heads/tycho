### Linux ###
*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

# End of https://www.toptal.com/developers/gitignore/api/linux

# Substreams spkg files are build artifacts
*.spkg
# Except the test spkg
!tycho-indexer/test/spkg/*

.env
.substreams.env

*/.env
.vscode
.zed
.idea
*.log

db/*.backup
/tycho-client-py/build/*
/tycho-client-py/*.egg-info
/tycho-client-py/tycho_client.egg-info/
/tycho-client-py/dist/

__pycache__/
